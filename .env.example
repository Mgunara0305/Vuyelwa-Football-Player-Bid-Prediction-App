# VuyelwaDiski Player Bid Predictor - Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key (generate a strong random key for production)
SECRET_KEY=your-very-secret-key-change-this

# Google OAuth Credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Google+ API" or "Google Identity"
# 4. Go to Credentials -> Create OAuth 2.0 Client ID
# 5. Set Authorized redirect URI to: http://localhost:5000/auth/google/authorized
# 6. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
